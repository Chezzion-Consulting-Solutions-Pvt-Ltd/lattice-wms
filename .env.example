COMPOSE_PROJECT_NAME=lattice

DJANGO_SECRET_KEY=change-me-for-local-dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,alpha.localhost,beta.localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,http://alpha.localhost:5173,http://beta.localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://alpha.localhost:5173,http://beta.localhost:5173
BASE_DOMAIN=localhost

POSTGRES_DB=lattice_control
POSTGRES_USER=lattice_control_app
POSTGRES_PASSWORD=local-control-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local-admin-password
TENANT_ALPHA_DB_PASSWORD=local-alpha-password
TENANT_BETA_DB_PASSWORD=local-beta-password

PGADMIN_DEFAULT_EMAIL=admin@lattice.example.com
PGADMIN_DEFAULT_PASSWORD=local-pgadmin-password

REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
